# Cambiar esta variable y ejecutar npm run preparar y npm run db:init.
RECURSO=eventos
PATROCINADORES_URL=http://127.0.0.1:3012
HOST=127.0.0.1
PORT=3011
DB_HOST=127.0.0.1
DB_PORT=3306
# Base y usuario se calculan como <RECURSO>_db y <RECURSO>_user.
DB_PASSWORD=cambiar-clave-local
# Debe ser la misma clave que usa ms-usuarios en tu PC.
JWT_SECRET=copiar-la-clave-de-ms-usuarios
USUARIOS_URL=http://127.0.0.1:3001
# Solo para npm run db:init; no se usan en el servidor HTTP.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
